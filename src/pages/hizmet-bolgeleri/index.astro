---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import { DISTRICTS } from '../../data/districts';
import { SITE } from '../../config/site';
---
<Base title="Hizmet Bölgeleri | Rize İlçeleri Oto Kuaför – Moon Auto" description="Moon Auto, Rize Merkez İslampaşa'dan tüm Rize'ye hizmet verir: Çayeli, Ardeşen, Pazar, Güneysu, Derepazarı, İyidere. İlçenizden mesafe ve süre bilgisi." canonical="/hizmet-bolgeleri/">
  <Breadcrumbs items={[{ name: 'Hizmet Bölgeleri' }]} />
  <section class="section" style="padding-top:1.5rem"><div class="container">
    <h1>Rize Genelinde Oto Kuaför ve Detailing</h1>
    <p class="lead">Stüdyomuz Rize Merkez İslampaşa'da; nüfusun %44'ünün yaşadığı merkezden ilçelere 10–40 dakika. Seramik ve PPF gibi uzun işlemlerde ilçeden gelen müşterilerimize esnek teslim saati sağlıyoruz.</p>
    <div class="card" style="margin:1.5rem 0">
      <h2>Rize Merkez</h2>
      <p style="color:var(--muted)">{SITE.address.full}. Merkezdeki müşterilerimiz için aynı gün yıkama, pasta cila ve far parlatma randevusu genellikle mümkündür. Nüfus: 153.597 (2025).</p>
      <a class="btn btn-primary" href="/randevu/">Randevu Al</a>
    </div>
    <div class="grid grid-3">
      {DISTRICTS.map((d) => <article class="card"><h3><a href={`/hizmet-bolgeleri/${d.slug}/`}>{d.name} Oto Kuaför</a></h3><p style="color:var(--muted)">{d.distanceKm} km · yaklaşık {d.driveMin} dk · nüfus {d.population.toLocaleString('tr-TR')}</p><a href={`/hizmet-bolgeleri/${d.slug}/`} style="font-weight:700">Detay →</a></article>)}
    </div>
  </div></section>
  <section class="section"><div class="container"><Cta /></div></section>
</Base>

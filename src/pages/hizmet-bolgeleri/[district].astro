---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { DISTRICTS } from '../../data/districts';
import { FEATURED, SERVICES } from '../../data/services';
import { SITE } from '../../config/site';
import { DISTRICT_DETAILS } from '../../data/districtDetails';
import { getService } from '../../data/services';
import { REVIEWS } from '../../data/reviews';
import TowingCard from '../../components/TowingCard.astro';

export function getStaticPaths() { return DISTRICTS.map((d) => ({ params: { district: d.slug }, props: { d } })); }
const { d } = Astro.props;
const title = `${d.name} Oto Kuaför ve Seramik Kaplama | Moon Auto Rize`;
const description = `${d.name}'den ${d.driveMin} dakika: Moon Auto Rize'de seramik kaplama, PPF, pasta cila, detaylı iç temizlik, premium yıkama ve ${d.name} oto çekici / yol yardım. Esnek teslim saati.`;
const faqs = [
  { q: `${d.name}'de oto çekici hizmetiniz var mı?`, a: `Evet. ${d.name} dahil Rize genelinde çekici çözüm ortaklarımızla yol yardım sağlıyoruz; aracınız stüdyomuza veya istediğiniz servise düz platformla taşınır. Fiyat mesafeye göre telefonda netleşir.` },
  { q: `${d.name}'den Moon Auto'ya nasıl gelirim?`, a: `Sahil yolu üzerinden Rize Merkez İslampaşa'ya yaklaşık ${d.distanceKm} km, ${d.driveMin} dakika. Adres: ${SITE.address.full}.` },
  { q: `${d.name}'de yerinde hizmet veriyor musunuz?`, a: 'Seramik, PPF ve detaylı iç temizlik kapalı ve tozsuz alan gerektirdiği için stüdyomuzda yapılır. Uzun işlemlerde araç teslim ve alım saatini sizinle birlikte planlıyoruz.' },
  { q: `${d.name}'den gelince aynı gün teslim olur mu?`, a: 'Yıkama, far parlatma, cam filmi ve antibakteriyel temizlik aynı gün teslim edilir. Pasta cila, seramik ve detaylı iç temizlik 1–2 gün, PPF 1–4 gün sürer.' },
];
const dd = DISTRICT_DETAILS[d.slug];
const allFaqs = [...faqs, ...(dd?.extraFaqs ?? [])];
const popular = (dd?.popular ?? []).map((p) => ({ ...p, s: getService(p.slug)! }));
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: `${d.name} Oto Kuaför ve Detailing`, provider: { '@id': SITE.url + '/#business' }, areaServed: { '@type': 'City', name: d.name, containedInPlace: { '@type': 'AdministrativeArea', name: 'Rize' } } };
---
<Base {title} {description} canonical={`/hizmet-bolgeleri/${d.slug}/`} jsonLd={ld} waText={`Merhaba Moon Auto, ${d.name}'den yazıyorum, randevu almak istiyorum.`}>
  <Breadcrumbs items={[{ name: 'Hizmet Bölgeleri', href: '/hizmet-bolgeleri/' }, { name: d.name }]} />
  <section class="section" style="padding-top:1.5rem"><div class="container two-col">
    <article class="prose">
      <p class="eyebrow">Rize · {d.name}</p>
      <h1>{d.name} Oto Kuaför, Seramik Kaplama ve Detaylı Temizlik</h1>
      <p>{d.intro}</p>
      <p>{d.name} ({d.population.toLocaleString('tr-TR')} nüfus) ile Rize Merkez arasındaki {d.distanceKm} kilometrelik yol, Karadeniz'in tuzlu havası ve sürekli yağmuru boyayı yıpratır. Bu yüzden {d.name}'den gelen müşterilerimizin en çok tercih ettiği hizmetler seramik kaplama, PPF ve detaylı iç temizliktir.</p>
      <h2>{d.name} müşterilerimiz için</h2>
      <ul class="checks">
        <li>Randevu saatinde teslim, bekleme yok</li>
        <li>Uzun işlemlerde ({d.landmarks} hattından gelenler için) esnek teslim-alım saati</li>
        <li>WhatsApp'tan fotoğrafla ön fiyat, yolunuz boşa çıkmaz</li>
        <li>PPF ve cam filmi için ayrı kapalı uygulama alanı</li>
      </ul>
      {dd && (
        <>
          <h2>{d.name}'den nasıl gelinir?</h2>
          <p>{dd.route}</p>
          <p><a class="btn btn-outline" href={SITE.mapsShare} target="_blank" rel="noopener">Google Haritalar'da yol tarifi</a></p>
          <h2>{d.name}'de araçları yıpratan koşullar</h2>
          <ul class="checks checks--x">{dd.conditions.map((c) => <li>{c}</li>)}</ul>
          <TowingCard place={d.name} />
          <h2>{d.name}'den gelen müşterilerimizin en çok tercih ettiği hizmetler</h2>
          <div class="grid grid-3">
            {popular.map((p) => <div class="card"><h3><a href={`/${p.s.slug}/`}>{p.s.name}</a></h3><p style="color:var(--muted)">{p.why}</p><div class="price">{p.s.priceFrom > 0 ? p.s.priceFrom.toLocaleString('tr-TR') + " TL'den" : 'Fiyat için arayın'}</div></div>)}
          </div>
          <div class="card" style="margin-top:1.5rem"><strong>İpucu:</strong> {dd.tip}</div>
          <p style="margin-top:1rem;color:var(--muted)">{dd.neighborhoods.join(', ')} ve çevresinden gelen araç sahiplerine hizmet veriyoruz.</p>
        </>
      )}
      <h2>Tüm hizmetlerimiz</h2>
      <div class="grid grid-2">{FEATURED.map((s) => <ServiceCard s={s} />)}</div>
      <p style="margin-top:1rem">Tüm hizmetler: {SERVICES.map((s, i) => <span><a href={`/${s.slug}/`}>{s.name}</a>{i < SERVICES.length - 1 ? ' · ' : ''}</span>)}</p>
      <h2>{d.name}'den gelen müşterilerimiz ne diyor?</h2>
      <div class="grid grid-2">{REVIEWS.slice(0, 2).map((r) => <blockquote class="review"><div class="stars">{'★'.repeat(r.stars)}</div><p>"{r.text}"</p><footer>— {r.name}, Google</footer></blockquote>)}</div>
      <div style="margin-top:2rem"><Faq faqs={allFaqs} /></div>
    </article>
    <aside class="aside"><div class="card">
      <h3>{d.name} → Moon Auto</h3>
      <p style="color:var(--muted)">{d.distanceKm} km · ~{d.driveMin} dk<br />{SITE.address.full}<br />{SITE.hours.text}</p>
      <div class="btn-row" style="flex-direction:column">
        <a class="btn btn-primary" href="/randevu/">📅 Randevu Al</a>
        <a class="btn btn-outline" href={SITE.mapsShare} target="_blank" rel="noopener">Yol tarifi</a>
      </div>
    </div></aside>
  </div></section>
  <section class="section"><div class="container"><Cta title={`${d.name}'den randevu alın`} wa={`Merhaba Moon Auto, ${d.name}'den yazıyorum, randevu almak istiyorum.`} /></div></section>
</Base>

---
import { priceLabel, type Service } from '../data/services';
const { s } = Astro.props as { s: Service };
const imgs = import.meta.glob('/public/images/services/*.webp', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const img = Object.keys(imgs).includes(`/public/images/services/${s.key}.webp`) ? `/images/services/${s.key}.webp` : null;
---
<article class="card">
  {img && <a href={`/${s.slug}/`}><img src={img} alt={`${s.h1} – Moon Auto Rize`} width="700" height="438" loading="lazy" decoding="async" /></a>}
  <div class="icon" aria-hidden="true">{s.icon}</div>
  <h3><a href={`/${s.slug}/`}>{s.h1}</a></h3>
  <p style="color:var(--muted)">{s.short}</p>
  <div class="price">{priceLabel(s.priceFrom)} · {s.duration}</div>
  <a href={`/${s.slug}/`} style="font-weight:700">Detaylar →</a>
</article>

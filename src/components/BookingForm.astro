---
import { SITE } from '../config/site';
import { SERVICES } from '../data/services';
const { preset = '' } = Astro.props as { preset?: string };
const slots: string[] = [];
for (let h = 8, m = 30; h < 18; ) { slots.push(`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`); m += 30; if (m === 60) { m = 0; h++; } }
---
<form class="form" id="booking" data-wa={SITE.whatsapp} novalidate>
  <div class="row">
    <label>Hizmet
      <select name="hizmet" required>
        <option value="">Seçin…</option>
        {SERVICES.map((s) => <option value={s.name} selected={s.slug === preset}>{s.name}</option>)}
        <option value="Birden fazla hizmet / teklif">Birden fazla hizmet / teklif istiyorum</option>
      </select>
    </label>
    <label>Araç (marka / model / yıl)
      <input name="arac" placeholder="Örn: Toyota Corolla 2022, beyaz" required />
    </label>
  </div>
  <div class="row">
    <label>Tarih <span class="hint">Pazar günleri kapalıyız</span>
      <input type="date" name="tarih" id="tarih" required />
    </label>
    <label>Saat <span class="hint">Aynı anda {SITE.capacity} araç alıyoruz</span>
      <select name="saat" required>{slots.map((t) => <option value={t}>{t}</option>)}</select>
    </label>
  </div>
  <div class="row">
    <label>Adınız Soyadınız<input name="ad" autocomplete="name" required /></label>
    <label>Telefon<input name="telefon" type="tel" inputmode="tel" autocomplete="tel" placeholder="05xx xxx xx xx" required /></label>
  </div>
  <label>Not <span class="hint">Aracın durumu, istediğiniz paket, ek talepler</span>
    <textarea name="not" rows="3"></textarea>
  </label>
  <div class="form-status" id="status" role="status"></div>
  <div class="btn-row" style="margin-top:.2rem">
    <button class="btn btn-wa" type="submit" style="font-size:1.05rem">WhatsApp ile Randevu Talebi Gönder</button>
  </div>
  <p class="hint">Bilgileriniz hazır bir WhatsApp mesajına dönüşür; "Gönder"e bastığınızda bize ulaşır ve saati onaylayarak dönüş yaparız.</p>
</form>
<script>
  const form = document.getElementById('booking') as HTMLFormElement;
  const status = document.getElementById('status')!;
  const dateEl = document.getElementById('tarih') as HTMLInputElement;

  // Bugünden öncesi seçilemez; 60 gün ileriye kadar
  const fmt = (d: Date) => { const x = new Date(d); x.setMinutes(x.getMinutes() - x.getTimezoneOffset()); return x.toISOString().slice(0, 10); };
  const today = new Date(); dateEl.min = fmt(today);
  const max = new Date(); max.setDate(max.getDate() + 60); dateEl.max = fmt(max);

  // Alana tıklanınca tarayıcının takvimini aç (Chrome/Edge/Android); desteklenmiyorsa klavye ile girilir
  const openPicker = () => { try { (dateEl as any).showPicker?.(); } catch {} };
  dateEl.addEventListener('click', openPicker);
  dateEl.addEventListener('focus', openPicker);

  const show = (cls: 'ok' | 'err', msg: string) => { status.className = `form-status ${cls}`; status.textContent = msg; };

  const compose = () => {
    const d = new FormData(form);
    const g = (k: string) => String(d.get(k) ?? '').trim();
    const [y, m, day] = g('tarih').split('-');
    const tarih = y ? `${day}.${m}.${y}` : '-';
    return `Merhaba Moon Auto, randevu talebim:\n• Hizmet: ${g('hizmet')}\n• Araç: ${g('arac')}\n• Tarih: ${tarih}\n• Saat: ${g('saat')}\n• Ad Soyad: ${g('ad')}\n• Telefon: ${g('telefon')}\n• Not: ${g('not') || '-'}`;
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const d = new Date(dateEl.value + 'T12:00:00');
    if (d.getDay() === 0) { show('err', 'Pazar günleri kapalıyız. Lütfen başka bir gün seçin.'); dateEl.focus(); return; }
    const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(compose())}`;
    show('ok', 'WhatsApp açılıyor… Mesajı göndermeyi unutmayın.');
    const w = window.open(url, '_blank');
    if (!w) window.location.href = url;
  });
</script>
